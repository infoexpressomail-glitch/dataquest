# ── Frontend + Backend ───────────────────────────────────────────────────────
VITE_SUPABASE_URL=

# ── Frontend (exposta no navegador; segura pois o RLS controla o acesso) ────
VITE_SUPABASE_ANON_KEY=

# ── Backend apenas — NUNCA exponha no frontend nem faça commit do valor real.
# Copie em Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# ── Backend — usada nas funcionalidades de IA (Google Gemini) ───────────────
GEMINI_API_KEY=

# ── Backend (F1) — segredo que assina os tokens de sessão (HMAC-SHA256). ────
# Gere um valor aleatório longo, ex.: `openssl rand -hex 32`. NUNCA no frontend.
# Se ficar vazio, cai para SUPABASE_SERVICE_ROLE_KEY (funciona, mas o ideal é
# definir um segredo dedicado — trocá-lo invalida todas as sessões).
SESSION_SECRET=

# ── Backend (F1) — validade da sessão em segundos (padrão: 28800 = 8h) ──────
SESSION_TTL_SECONDS=

# ── Backend — URL pública onde a aplicação está hospedada ───────────────────
APP_URL=
